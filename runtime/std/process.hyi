// Hylian standard library interface — std.process
// Process spawning and management.
//
// Usage:
//   include {
//       std.process,
//   }
//
// Example:
//   int code = spawn("gcc", ["-o", "out", "src.c"]);
//   if (code != 0) {
//       panic("build failed");
//   }
//
//   str stdout = output("ls", ["-la"]);
//   println(stdout);
//
//   ProcessStatus s = status("git", ["status"]);
//   println(s.stdout);

module std.process

// Spawn a process and wait for it to finish.
// Returns the exit code (0 = success, non-zero = failure).
// Returns -1 if the process could not be spawned.
//
// Example:
//   int code = spawn("mkdir", ["-p", "build"]);
fn spawn(path: str, args: str[]) -> int

// Spawn a process and capture its stdout as a string.
// Returns the captured stdout, or an empty string on failure.
//
// Example:
//   str result = output("uname", ["-a"]);
fn output(path: str, args: str[]) -> str

// Result of a process execution with captured stdout and stderr.
class ProcessStatus {
    // The exit code (0 = success).
    fn exit_code() -> int

    // Captured stdout output.
    fn stdout() -> str

    // Captured stderr output.
    fn stderr() -> str
}

// Spawn a process and capture both stdout and stderr.
// Returns a ProcessStatus with the exit code and captured output.
//
// Example:
//   ProcessStatus s = status("gcc", ["-c", "file.c"]);
//   if (s.exit_code() != 0) {
//       eprintln(s.stderr());
//   }
fn status(path: str, args: str[]) -> ProcessStatus
